{
  "components": {
    "schemas": {
      "ApiResponse": {
        "properties": {
          "code": {
            "description": "0=成功，17=非法请求，5=参数错误，2=登录失效",
            "type": "integer"
          },
          "data": {
            "type": "object"
          },
          "msg": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "OutlineNode": {
        "properties": {
          "children": {
            "items": {
              "$ref": "#/components/schemas/OutlineNode"
            },
            "type": "array"
          },
          "done": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "note": {
            "description": "备注 HTML",
            "type": "string"
          },
          "task": {
            "type": "boolean"
          },
          "text": {
            "description": "HTML 字符串，支持 b/i/s/u/a/br",
            "type": "string"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "jwtToken": {
        "description": "从浏览器 localStorage 获取 mubu.com 的 Jwt-Token，或调 phone_login 获取",
        "in": "header",
        "name": "Jwt-Token",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "幕布大纲笔记内部接口文档。幕布无公开 API，以下均为整理自 Web 端/桌面端的内部接口，随时可能变更。\n\n来源：jackwener/OpenCLI、liuboacean/mubu-integration、cnfjlhj/cli-anything-mubu、qinze889/mubu_syn 源码 + 浏览器抓包（2026-10-12）。",
    "title": "幕布 (mubu.com) 内部 API",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/v3/api/colla/events": {
      "post": {
        "description": "网页端真实写接口。需带请求头 x-reg-entrance: https://mubu.com/app/edit/home/{doc_id}。memberId 可用登录返回的 userId。",
        "parameters": [
          {
            "in": "header",
            "name": "x-reg-entrance",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "documentId": {
                    "type": "string"
                  },
                  "events": {
                    "items": {
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "memberId": {
                    "type": "string"
                  },
                  "type": {
                    "default": "CHANGE",
                    "type": "string"
                  },
                  "version": {
                    "description": "baseVersion",
                    "type": "integer"
                  }
                },
                "required": [
                  "memberId",
                  "type",
                  "version",
                  "documentId",
                  "events"
                ],
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse"
                }
              }
            },
            "description": "data.latestVersion"
          }
        },
        "summary": "推送文档变更（写操作）",
        "tags": [
          "实时协同"
        ]
      }
    },
    "/v3/api/colla/latestEvents": {
